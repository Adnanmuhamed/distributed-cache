# .env.example
#
# Copy to .env and adjust values before running docker compose.
# docker compose automatically reads .env from the project root.
#
# All values shown are the defaults — you only need to set a variable
# if you want to override the default.

# ── Gateway ───────────────────────────────────────────────────────────────────

# Host port the gateway is published on (default: 3000).
# Change to avoid conflicts with other services on your machine.
GATEWAY_HOST_PORT=3000

# Number of virtual nodes per physical cache node in the consistent hash ring.
# Higher values → more uniform key distribution at the cost of memory.
VIRTUAL_NODES=100

# Timeout (ms) for gateway → cache-node HTTP requests.
REQUEST_TIMEOUT_MS=5000

# ── Cache nodes ───────────────────────────────────────────────────────────────

# Maximum number of cache entries per node before eviction triggers.
NODE_CAPACITY=1000

# Eviction policy applied to all three nodes: LRU or LFU.
NODE_POLICY=LRU
